  "keyFeatures": [
    "Extract character sheets from Fantasy Grounds db.xml files",
    "Generate individual XML files per character",
    "Filter out sensitive tags (public, holder)",
    "Calculate skill totals with proficiency bonuses",
    "Cross-platform support (macOS, Windows, Linux)"
